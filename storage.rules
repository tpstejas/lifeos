rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // User's private files - organized by user ID
    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Item attachments (PDFs, images, audio, etc.)
    match /items/{itemId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        request.resource.size < 50 * 1024 * 1024 && // 50MB max
        (request.resource.contentType.matches('image/.*') ||
         request.resource.contentType.matches('application/pdf') ||
         request.resource.contentType.matches('audio/.*') ||
         request.resource.contentType.matches('video/.*') ||
         request.resource.contentType.matches('text/.*'));
    }

    // Shared/public files (if implementing sharing)
    // match /shared/{shareId}/{allPaths=**} {
    //   allow read: if true;
    //   allow write: if false; // Only via Cloud Functions
    // }

    // Temporary uploads (cleaned up by Cloud Function)
    match /temp/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}